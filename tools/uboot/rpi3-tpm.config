# Config fragment on top of rpi_3_defconfig (Pi 3B+, 64-bit). Merged by the Dockerfile.

# Control DT: U-Boot's own 3B+ DT plus a bit-banged SPI TPM node. The firmware DT is not
# used as control DT (OF_BOARD) so Linux's DT stays exactly what start.elf built.
# CONFIG_OF_BOARD is not set
CONFIG_OF_SEPARATE=y
CONFIG_DEFAULT_DEVICE_TREE="bcm2837-rpi-3-b-plus"
CONFIG_DEVICE_TREE_INCLUDES="rpi3-tpm-softspi.dtsi"

# TPM 2.0 over TIS-SPI; no BCM2835 SPI driver upstream, so GPIO bit-banging
CONFIG_SPI=y
CONFIG_DM_SPI=y
CONFIG_SOFT_SPI=y
CONFIG_TPM=y
CONFIG_TPM_V2=y
CONFIG_TPM2_TIS_SPI=y
CONFIG_CMD_TPM=y
# Would re-allocate the TPM's PCR banks (persistent TPM configuration change): keep off
# CONFIG_TPM_PCR_ALLOCATE is not set

# Measured boot through UEFI: bootefi measures the kernel (PCR 4) and the DTB (PCR 1) and
# publishes a TCG2 event log in the EFI config table, which Linux exposes in securityfs
CONFIG_EFI_LOADER=y
CONFIG_EFI_TCG2_PROTOCOL=y
CONFIG_EFI_TCG2_PROTOCOL_MEASURE_DTB=y
# No storage for EFI variables (nothing writable to keep them on in a netboot setup)
CONFIG_EFI_VARIABLE_NO_STORE=y
# CONFIG_EFI_VARIABLE_FILE_STORE is not set
CONFIG_CMD_UNZIP=y
CONFIG_CMD_FDT=y

# Fixed, non-interactive boot: nothing outside the measured inputs can change what runs
CONFIG_BOOTDELAY=-2
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_USE_PREBOOT is not set
# CONFIG_BOOTSTD_BOOTCOMMAND is not set
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="usb start; setenv autoload no; dhcp; setenv serverip 10.42.0.1; tftpboot ${kernel_comp_addr_r} kernel8.img; unzip ${kernel_comp_addr_r} ${kernel_addr_r}; fdt addr ${fdt_addr}; fdt get value bootargs /chosen bootargs; fdt rm /chosen kaslr-seed; fdt rm /chosen rng-seed; bootefi ${kernel_addr_r} ${fdt_addr}"
