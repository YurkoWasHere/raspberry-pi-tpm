# Copy to .env and edit. .env is not committed.

# Dedicated NIC cabled directly to the Pi. NEVER your LAN interface.
# Find it with `ip -br link` after plugging the card in.
IFACE=CHANGE_ME
SERVER_IP=10.42.0.1
PREFIX=24
DHCP_RANGE=10.42.0.50,10.42.0.150

# Optional: per-port-power hub for cold boots (uhubctl location and port), see netboot/pi-power.sh
PI_HUB=CHANGE_ME
PI_HUB_PORT=CHANGE_ME
